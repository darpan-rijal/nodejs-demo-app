pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building application...'
                sh 'npm install'
            }
        }
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'docker build -t nodejs-demo-app:latest .'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker rm -f nodejs-demo-app || true'
                sh 'docker run -d --name nodejs-demo-app -p 3000:3000 nodejs-demo-app:latest'
            }
        }
    }
}
